[Unit]
Description=Botalin bot — scalping (5m/15m)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/botalin
EnvironmentFile=-/etc/botalin.env
Environment=BOTALIN_SERVER_PROFILE=training
Environment=BOTALIN_USER_LOGIN=server-scalping
Environment=BOTALIN_STRATEGY=scalping
ExecStartPre=/usr/bin/git -C /opt/botalin pull --ff-only --quiet
ExecStart=/usr/bin/node /opt/botalin/share/strategy-lab-7q4m2v/server-autobot.mjs --once
Nice=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
