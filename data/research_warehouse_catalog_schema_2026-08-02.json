    "decision_time": {
      "prefix": "dt.",
      "meaning": "Known and legitimately readable at decision time t (ingest_ts <= t)."
    },
    "execution_time": {
      "prefix": "ex.",
      "meaning": "Known only at or after order placement/fill. Never readable by a detector."
    },
    "outcome_time": {
      "prefix": "oc.",
      "meaning": "Known only after the position resolves. Never readable by a detector, guard, or rule."
    }
  },
